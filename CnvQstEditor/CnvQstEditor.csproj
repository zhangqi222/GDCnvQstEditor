<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CnvQstEditor</AssemblyName>
    <Product>CnvQstEditor</Product>
    <Description>Grim Dawn .cnv/.qst 图形化查看、编辑、新建、导入导出与批量处理（格式见 CnvQstFormatDecoded.md）</Description>
    <Version>2.0.21</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CnvQstLib\CnvQstLib.csproj" />
    <ProjectReference Include="..\GdAssets\GdAssets.csproj" />
  </ItemGroup>

  <!-- 窗口图标（EXE 图标由 ApplicationIcon 嵌入，窗口图标需作为程序集资源供 Avalonia 读取） -->
  <ItemGroup>
    <AvaloniaResource Include="app.ico" />
  </ItemGroup>

  <!-- UI 语言包：中文为基准（键清单模板），其它语言放 lang/*.json 即生效（无需改代码）。
       同时内嵌进程序集：单文件发布无需外部 lang 目录；磁盘 lang\*.json 仍优先（自定义/新增语言）。 -->
  <ItemGroup>
    <EmbeddedResource Include="lang\*.json" WithCulture="false" />
    <None Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Avalonia 11.3 系（MIT）：TreeDataGrid 11.0.10 为最后 MIT 免费版，12+ 起为商业授权 -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.TreeDataGrid" Version="11.0.10" />
    <PackageReference Include="Semi.Avalonia" Version="11.3.22" />
    <PackageReference Include="Semi.Avalonia.DataGrid" Version="11.3.13" />
    <PackageReference Include="Semi.Avalonia.TreeDataGrid" Version="11.0.10.4" />
  </ItemGroup>

</Project>