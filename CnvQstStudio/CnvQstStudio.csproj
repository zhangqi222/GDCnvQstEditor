<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CnvQstStudio</AssemblyName>
    <Product>CnvQstStudio</Product>
    <Description>Grim Dawn .cnv/.qst 图形化查看、编辑、新建、导入导出与批量处理（格式见 CnvQstFormatDecoded.md）</Description>
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CnvQstLib\CnvQstLib.csproj" />
  </ItemGroup>

  <!-- UI 语言包：中文为基准（键清单模板），其它语言放 lang/*.json 即生效（无需改代码） -->
  <ItemGroup>
    <None Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Avalonia 11.3 系（MIT）：TreeDataGrid 11.0.10 为最后 MIT 免费版，12+ 起为商业授权 -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.TreeDataGrid" Version="11.0.10" />
    <PackageReference Include="Semi.Avalonia" Version="11.3.22" />
    <PackageReference Include="Semi.Avalonia.DataGrid" Version="11.3.13" />
    <PackageReference Include="Semi.Avalonia.TreeDataGrid" Version="11.0.10.4" />
  </ItemGroup>

</Project>