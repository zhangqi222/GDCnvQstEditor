// ============================================================================
// JSON → QST 全类型目录（JSONC）
//
// 目的：把 30 种条件（type 0–29）与 27 个可用动作（type 1–28，0/16 无工厂）放进一个 objective，
// 作为"任意 JSON 都能生成"的回归样例与字段查表。生成命令：
//   dotnet CnvQstTool/bin/Debug/net8.0/CnvQstTool.dll make JSON示例/qst_all_conditions_actions.jsonc -o 输出.qst
//
// 说明：
//   · QST 与 CNV 共用同一套条件/动作；写法、字段名、cmp 语义完全一致。
//   · 本文件的 incentive/event 各占一个本地化槽（工具自动补空行）；objective 的 text 落入目标文本槽。
//   · 条件 logic=OR、动作按书写顺序执行，仅为演示。
//   · 字段完整含义见文档 JSON转QST.md 与 JSON转CNV.md 的"条件全表 / 动作全表"。
// ============================================================================
{
  "format": "qst",         // "qst"（任务）:生成 .qst。"cnv"（对话）:生成 .cnv。
  "version": 9,            // 7（旧版）:task 无尾部。8:带 flag8。9（推荐）:带 flag8+flag9；语料全为 9。
  "flags": 1,              // 头部任务 flags：0 None / 1 Primary 主任务 / 2 Secondary 支线 / 4 Repeatable 可重复；可相加。
  "id": 0,                 // 文件 id（u32）；与 task uid 无关。
  "group": "CATALOG_GROUP",// 任务组名（本地化槽 0）。
  "name": "CATALOG_QUEST", // 任务名（本地化槽 1）。
  "lang": "enUS",          // 语言标签："enUS" 英文（默认）；其它如 zhCN/deDE。

  "tasks": [
    {
      "uid": 305419896,    // task uid（落盘 u32）：被 Task 引用；省略/0 自动随机生成。
      "unknownAC": 0,      // task 的 unknownAC：保持 0。
      "flag8": false,      // version>=8 尾部字节；false=0。
      "flag9": false,      // version>=9 尾部字节；false=0。
      "title": "全类型任务", // task 标题（本地化槽）。
      "desc": "演示全部条件与动作。", // task 描述（本地化槽）。

      // incentives（OnAccept）：每个元素占一个本地化槽；这里演示空条件 + 一条通知。
      "incentives": [
        {
          "unknown": 0,    // 事件头 u32；保持 0。
          "logic": "AND",  // 条件关系："AND" 全部满足 / "OR" 任一满足。
          "cond": [],      // 条件列表。
          "act": [
            { "Notification": ["tagCatalogAccepted"] } // Notification：Tag（本地化标签）。
          ]
        }
      ],

      // objectives：目标文本 + 完成条件 + 完成动作。
      "objectives": [
        {
          "uid": 2271560481, // objective uid（落盘 u32）：被 HasQuestObjective 引用；省略/0 自动随机。
          "unknown1": 0,     // objective 的 unknown1；保持 0。
          "text": "全类型目标", // 目标文本（本地化槽）。
          "logic": "OR",      // 条件关系："AND" 全部满足 / "OR" 任一满足。

          // ==================================================================
          // 条件全表（30 种）：{ "官方类型名": 参数, "cmp": 可选比较符 }
          // cmp："<"=0、"<="=1、"="=2（默认）、">="=3、">"=4、"!="=5。
          // ==================================================================
          "cond": [
            { "OnQuest": ["quests/example.qst", true] },                          // 0  OnQuest：任务文件+布尔
            { "QuestTaskComplete": ["quests/example.qst", 305419896, true] },      // 1  QuestTaskComplete：文件+task uid+布尔
            { "HasExperience": [10000], "cmp": ">=" },                             // 2  HasExperience：经验
            { "IsLevel": [10], "cmp": ">=" },                                      // 3  IsLevel：等级
            { "IsDifficulty": [2], "cmp": "=" },                                   // 4  IsDifficulty：0 普通/1 精英/2 终极
            { "IsHardcore": [false] },                                             // 5  IsHardcore：布尔
            { "HasFaction": ["SURVIVORS", 5000], "cmp": ">=" },                    // 6  HasFaction：阵营+数值
            { "HasToken": ["TOKEN_A", true] },                                     // 7  HasToken：令牌+布尔
            { "HasMoney": [1000], "cmp": ">=" },                                   // 8  HasMoney：金币
            { "HasItem": ["records/items/gear/example.dbr", 1, false], "cmp": ">=" }, // 9  HasItem：物品+数量+CompleteOnly
            { "HasKilled": { "MonsterRecords": ["records/monsters/example.dbr"], "KillCount": 1 }, "cmp": ">=" }, // 10 HasKilled：怪物列表+KillCount
            { "HasQuestObjective": { "Quest": "quests/example.qst", "Task": 305419896, "Objective": 2271560481, "Satisfied": true } }, // 11 任务+目标 uid+布尔
            { "LuaScript": { "call": "gd.example.check()", "args": ["arg1"], "tail": { "t0": 0, "t1": 0, "t2": 0, "t3": 0, "text": "TRUE" } } }, // 12 Lua+Evaluate 尾部
            { "KnowsPlayer": [true] },                                             // 13 KnowsPlayer：布尔
            { "OnQuestTask": ["quests/example.qst", 305419896, true] },            // 14 OnQuestTask：文件+task uid+布尔
            { "UsedQuestItem": ["records/items/quest/example.dbr", 1], "cmp": ">=" }, // 15 UsedQuestItem：物品+次数
            { "HasKilledProxy": { "ProxyRecords": ["records/proxies/example.dbr"], "KillCount": 1 }, "cmp": ">=" }, // 16 HasKilledProxy：代理列表+KillCount
            { "WaitForCompletion": {} },                                           // 17 WaitForCompletion：无字段
            { "ServerHasToken": ["TOKEN_B", true] },                               // 18 ServerHasToken：令牌+布尔
            { "QuestBlocked": ["quests/example.qst", false] },                     // 19 QuestBlocked：文件+布尔
            { "AnyoneHasToken": ["TOKEN_C", false] },                              // 20 AnyoneHasToken：令牌+布尔
            { "CheckRandomValue": ["roll", 50], "cmp": "<=" },                     // 21 CheckRandomValue：名称+数值
            { "OwnsDLC": [1], "cmp": "=" },                                        // 22 OwnsDLC：DLC_ID
            { "HasTribute": [10], "cmp": ">=" },                                   // 23 HasTribute：贡品
            { "EarnedDevotion": [20], "cmp": ">=" },                               // 24 EarnedDevotion：虔诚点
            { "HasMastery": [0, true] },                                           // 25 HasMastery：SkillClass 下标 0..29+布尔
            { "IsChallenge": [2], "cmp": ">=" },                                   // 26 IsChallenge：0 普通老兵/1 精英老兵/2 终极老兵
            { "HasBuff": ["records/buffs/example.dbr", true] },                    // 27 HasBuff：Buff 文件+布尔
            { "HasKilledMonsterClass": [0, 5, 1], "cmp": ">=" },                   // 28 怪物类别1+2+KillCount（0 Common…5 SuperBoss）
            { "HasKilledFaction": [4, 5, 100], "cmp": ">=" }                       // 29 阵营1+2+KillCount（0 None/4 Survivors/5 Aetherials…）
          ],

          // ==================================================================
          // 动作全表（27 个可用槽；type 0/16 工厂返回 null，不能写入）。
          // 动作按数组顺序执行，没有 cmp / AND / OR。
          // ==================================================================
          "act": [
            { "BeginQuestTask": ["quests/example.qst", 305419896] },               // 1  BeginQuestTask：文件+task uid
            { "CompleteQuest": ["quests/example.qst"] },                           // 2  CompleteQuest：文件
            { "CompleteQuestTask": ["quests/example.qst", 305419896] },            // 3  CompleteQuestTask：文件+task uid
            { "GiveMoney": [500] },                                                // 4  GiveMoney：金币
            { "GiveFaction": ["SURVIVORS", 100] },                                 // 5  GiveFaction：阵营+数量
            { "GiveItem": ["records/items/gear/example.dbr", 1] },                 // 6  GiveItem：物品+数量
            { "GiveLevel": [1] },                                                  // 7  GiveLevel：等级数
            { "GiveExperience": [1000] },                                          // 8  GiveExperience：经验
            { "GiveToken": ["TOKEN_A"] },                                          // 9  GiveToken：令牌
            { "RemoveToken": ["TOKEN_A"] },                                        // 10 RemoveToken：令牌
            { "LuaScript": { "call": "gd.example.run()", "args": ["arg1"] } },     // 11 LuaScript：调用+参数
            { "DebugPrint": ["hello"] },                                           // 12 DebugPrint：文本
            { "PlaySound": ["records/sounds/example.dbr"] },                       // 13 PlaySound：声音记录
            { "PlayAnimation": [9] },                                              // 14 PlayAnimation：动画枚举（9=Chat）
            { "GiveSkillPoint": [1] },                                             // 15 GiveSkillPoint：技能点
            { "Notification": ["tagExample"] },                                    // 17 Notification：本地化标签
            { "GiveAttribPoint": [1] },                                            // 18 GiveAttribPoint：属性点
            { "ScriptEvent": ["EV_EXAMPLE"] },                                     // 19 ScriptEvent：事件名
            { "GiveRandomItem": ["records/items/gear/example.dbr", 2] },           // 20 GiveRandomItem：物品+数量
            { "GenerateRandomValue": ["roll", 1, 100] },                           // 21 GenerateRandomValue：名称+最小值+最大值
            { "CastSkill": ["records/skills/example.dbr"] },                       // 22 CastSkill：技能记录
            { "UnlockFaction": ["SURVIVORS"] },                                    // 23 UnlockFaction：阵营
            { "SetFaction": ["SURVIVORS", 1000] },                                 // 24 SetFaction：阵营+数值
            { "GiveDevotion": [1] },                                               // 25 GiveDevotion：虔诚点
            { "GiveTribute": [10] },                                               // 26 GiveTribute：贡品
            { "UnlockTutorial": [1] },                                             // 27 UnlockTutorial：教程页
            { "PlayVideo": ["video/intro.ivf", false] }                            // 28 PlayVideo：视频路径+允许跳过
          ]
        }
      ],

      // events（OnComplete）：每个元素占一个本地化槽；这里演示空条件 + 完成任务。
      "events": [
        {
          "unknown": 0,
          "logic": "AND",
          "cond": [],
          "act": [
            { "CompleteQuest": ["quests/example.qst"] },                       // 2 CompleteQuest：文件
            { "GiveExperience": [2500] },                                      // 8 GiveExperience：经验
            { "GiveMoney": [1000] }                                            // 4 GiveMoney：金币
          ]
        }
      ]
    }
  ]
}
