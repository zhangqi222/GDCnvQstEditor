// ============================================================================
// JSON → QST 全量示例（JSONC：允许 // 与 /* */ 注释，允许尾逗号）
//
// 本文件同时覆盖：全部顶层字段、全部 task / incentive / objective / event 字段、
// 持久化 uid、30 种条件、27 个可用动作、以及 languages 多语言块。
// 生成命令（仓库根目录）：
//   dotnet CnvQstEditor/bin/Debug/net8.0-windows/CnvQstEditor.dll convert JSON示例/qst_full.json -o 输出.qst
//   CnvQstEditor-cli.exe convert JSON示例/qst_full.json -o 输出.qst
// 生成后可用 verify 回读校验：
//   CnvQstEditor-cli.exe verify 输出.qst
//
// ----------------------------------------------------------------------------
// 字段总览（下文每个字段都有更详细的就地注释）
// ----------------------------------------------------------------------------
// 顶层：
//   format     string  必填  "qst"（生成 .qst）或 "cnv"（生成 .cnv，见另一文档）
//   version    u32     可选  ≥7；7=task 无尾部，8=+flag8，9=+flag8+flag9（推荐）
//   flags      u32     可选  头部任务标志：1 主任务 / 2 支线 / 4 可重复（可相加）
//   id         u32     可选  本文件自有 ID；省略=随机非 0；写 0 就是 0
//   group      string  可选  任务组名，本地化槽 0
//   name       string  可选  任务名，本地化槽 1
//   languages  array   可选  显式语言块；写了就以它为准，group/name/title… 仅作回退
//   tasks      array   必填  任务数组
//
// languages[] 每项：
//   tag        string  必填  语言标签（官方 6 种：enUS/enGB/es/fr/de/it）
//   texts      array   必填  文本行；行数必须等于 §本地化槽位公式 的结果，缺/多行都会报错
//
// tasks[] 每项：
//   uid        u32     可选  持久化 task uid；省略/0=随机非 0；跨文件引用时使用
//   unknownAC  u32     可选  task 头部保留值，保持 0
//   flag8      bool    可选  version>=8 尾部字节；false=0
//   flag9      bool    可选  version>=9 尾部字节；false=0
//   title      string  可选  任务标题（本地化槽）
//   desc       string  可选  任务描述（本地化槽）
//   incentives array   可选  OnAccept 事件；每个元素占 1 个本地化槽（官方为空行）
//   objectives array   可选  任务目标；每个目标的 text 占 1 个本地化槽
//   events     array   可选  OnComplete 事件；每个元素占 1 个本地化槽（官方为空行）
//
// incentive / event 每项：
//   unknown    u32     可选  事件头保留值，保持 0
//   logic      string  可选  条件关系 "AND"/"OR"
//   cond       array   可选  条件列表（写法与 CNV 完全相同）
//   act        array   可选  动作列表（按顺序执行，无 cmp / AND / OR）
//
// objectives[] 每项：
//   uid        u32     可选  持久化 objective uid；省略/0=随机；被 HasQuestObjective 引用
//   unknown1   u32     可选  目标保留值，保持 0
//   text       string  可选  目标文本（本地化槽）
//   logic      string  可选  条件关系 "AND"/"OR"
//   cond       array   可选  完成/可交互的判定条件
//   act        array   可选  条件满足/目标完成时执行的动作
//
// ----------------------------------------------------------------------------
// 本地化槽位公式（languages.texts 必须按此顺序、恰好这么多行）：
//   总数 = 2（组名、任务名）
//        + Σ 每个 task [ 2（标题、描述）+ incentive 数 + objective 数 + event 数 ]
// 槽位顺序：
//   0=组名，1=任务名，
//   然后按 tasks 顺序，每个 task：标题、描述、各 incentive、各 objective 文本、各 event。
//
// 换行写法：游戏内换行用字面量 {^n} 表示（例如 desc 里写 "第一行{^n}第二行"）。
// ----------------------------------------------------------------------------
// languages 写法要点：
//   · 显式 languages 存在时，以 texts 为准；group/name/title/desc/text 仍必须写，
//     但不会覆盖 languages。
//   · 每个语言块的 texts 行数都必须相同，且必须等于上面的公式结果。
//   · incentive / event 的槽官方都是空串；本示例也留空，但空字符串仍必须占位。
// ============================================================================
{
  "format": "qst",

  // 版本：7=task 无尾部；8=+flag8；9=+flag8+flag9（推荐，语料全为 9）。
  "version": 9,

  // 头部任务 flags（位掩码）：1 主任务 / 2 支线 / 4 可重复；可相加（如 5=主任务+可重复）。
  "flags": 1,

  // 文件 id（头部 +0x0C，u32）：省略=随机非 0；显式写（含 0）原样使用；与 task uid 无关。
  "id": 0,

  // 任务组名（本地化槽 0）：游戏任务列表的分组标题。
  "group": "EXAMPLE_GROUP",

  // 任务名（本地化槽 1）：游戏内显示的任务名。
  "name": "EXAMPLE_QUEST",

  // --------------------------------------------------------------------------
  // languages：显式语言块。本文件演示 1 个语言块（enUS）。
  // 行数 = 2 + (2+1+2+1) + (2+0+1+0) + (2+1+1+1) = 16 行；注释标出对应槽位。
  // --------------------------------------------------------------------------
  "languages": [
    {
      "tag": "enUS",
      "texts": [
        "EXAMPLE_GROUP",              // 槽 0  = 组名 group
        "EXAMPLE_QUEST",              // 槽 1  = 任务名 name
        "任务标题",                    // 槽 2  = task1 标题
        "这是任务描述。",              // 槽 3  = task1 描述
        "",                           // 槽 4  = task1 incentive#1（OnAccept 槽，官方为空）
        "收集 5 个物品",               // 槽 5  = task1 objective#1 文本
        "返回交任务",                  // 槽 6  = task1 objective#2 文本
        "",                           // 槽 7  = task1 event#1（OnComplete 槽，官方为空）
        "第二个任务",                  // 槽 8  = task2 标题
        "没有 OnAccept / OnComplete 事件。", // 槽 9 = task2 描述
        "达到 10 级",                  // 槽 10 = task2 objective#1 文本
        "全类型任务",                  // 槽 11 = task3 标题
        "演示全部条件与动作。",        // 槽 12 = task3 描述
        "",                           // 槽 13 = task3 incentive#1
        "全类型目标",                  // 槽 14 = task3 objective#1 文本
        ""                            // 槽 15 = task3 event#1
      ]
    }
    // 多语言示例：复制上面的对象，改 tag 与 texts 即可（每个块的 texts 行数必须相同）。
    // { "tag": "enGB", "texts": [ "EXAMPLE_GROUP", "EXAMPLE_QUEST", "Quest Title", … ] }
  ],

  "tasks": [
    // ------------------------------------------------------------------------
    // Task 1：完整演示 OnAccept / 目标 / OnComplete。
    // ------------------------------------------------------------------------
    {
      // task uid（落盘 u32）：其它 CNV/QST 的 Task 引用填这个值；省略/0=自动随机非 0。
      // 建议显式指定并保证全项目唯一；它不是数组下标，也不由任务名哈希得到。
      "uid": 305419896,

      // task 的 unknownAC（落盘 u32）：保持 0。
      "unknownAC": 0,

      // flag8（version>=8 才写入）：false=0，true=1；保留/未解码语义。
      "flag8": false,

      // flag9（version>=9 才写入）：false=0，true=1；保留/未解码语义。
      "flag9": false,

      // 任务标题（本地化槽）：任意字符串。
      "title": "任务标题",

      // 任务描述（本地化槽）：任意字符串；换行写 {^n}。
      "desc": "这是任务描述。",

      // incentives（编辑器 OnAccept 事件）：[]=接任务时不触发；每个元素占一个本地化槽。
      "incentives": [
        {
          // 事件头 u32：保持 0。
          "unknown": 0,

          // 条件关系："AND" 全部满足（默认）/ "OR" 任一满足。
          "logic": "AND",

          // 条件列表：[]=无条件，事件必定触发；写法与 CNV 相同。
          "cond": [],

          // 动作列表：按顺序执行；Notification 的 Tag 是本地化标签。
          "act": [
            { "Notification": ["tagQuestAccepted"] }
          ]
        }
      ],

      // objectives（任务目标）：[]=没有可见目标；每个目标含文本、条件、动作。
      "objectives": [
        {
          // objective uid（落盘 u32）：被 HasQuestObjective 的 Objective 引用；省略/0=随机。
          "uid": 2271560481,

          // objective 的 unknown1（落盘 u32）：保持 0。
          "unknown1": 0,

          // 目标文本（本地化槽）。
          "text": "收集 5 个物品",

          // 条件关系与条件列表：目标「完成/可交互」的判定条件。
          "logic": "AND",
          "cond": [
            // HasItem：ItemRecord（.dbr 路径）+ ItemCount（数量）+ CompleteOnly（布尔）；
            // 默认 bodyVersion=1，CompleteOnly 才会落盘。
            { "HasItem": ["records/items/quest/example.dbr", 5, false], "cmp": ">=" }
          ],

          // 目标动作：条件满足/目标完成时执行；[]=无动作。
          "act": [
            { "Notification": ["tagObjectiveComplete"] }
          ]
        },
        {
          // 第二个目标：演示 WaitForCompletion（无字段条件）。
          "uid": 286331170,
          "text": "返回交任务",
          "cond": [
            { "WaitForCompletion": {} }
          ],
          "act": []
        }
      ],

      // events（编辑器 OnComplete 事件）：[]=交任务时不触发；每个元素占一个本地化槽。
      "events": [
        {
          "unknown": 0,
          "logic": "AND",
          "cond": [
            // HasQuestObjective：Quest 文件 + Task uid + Objective uid + Satisfied（布尔）。
            // 引用值必须是本文件里真实存在的持久化 uid。
            {
              "HasQuestObjective": {
                "Quest": "quests/example.qst",
                "Task": 305419896,
                "Objective": 2271560481,
                "Satisfied": true
              }
            }
          ],
          "act": [
            // CompleteQuestTask：QuestFile + Task（task uid）。
            { "CompleteQuestTask": ["quests/example.qst", 305419896] },

            // 奖励：经验与金币。
            { "GiveExperience": [2500] },
            { "GiveMoney": [1000] }
          ]
        }
      ]
    },

    // ------------------------------------------------------------------------
    // Task 2：最小 task；演示省略 incentives / events（等价于 []）与随机 uid。
    // ------------------------------------------------------------------------
    {
      // 省略 uid：工具会生成非 0 随机值；要被其它文件引用时请显式填写。
      "title": "第二个任务",
      "desc": "没有 OnAccept / OnComplete 事件。",
      "objectives": [
        {
          "text": "达到 10 级",
          "cond": [
            // IsLevel：等级；cmp ">=" 表示达到或超过。
            { "IsLevel": [10], "cmp": ">=" }
          ],
          "act": []
        }
      ]
    },

    // ------------------------------------------------------------------------
    // Task 3：全类型目录，把 30 种条件与 27 个可用动作各写一次，便于查表。
    // 条件 logic=OR（任一满足，仅演示）；动作按数组顺序执行。
    // 每个条目的注释给出：类型号、官方名、字段顺序、取值说明。
    // ------------------------------------------------------------------------
    {
      "uid": 3149642683,
      "title": "全类型任务",
      "desc": "演示全部条件与动作。",

      "incentives": [
        {
          "unknown": 0,
          "logic": "AND",
          "cond": [],
          "act": [
            { "Notification": ["tagCatalogAccepted"] }
          ]
        }
      ],

      "objectives": [
        {
          "uid": 3405691582,
          "text": "全类型目标",
          "logic": "OR",

          "cond": [
            // type 0 OnQuest：QuestFile（任务文件串）+ OnQuest（布尔）。
            { "OnQuest": ["quests/example.qst", true] },

            // type 1 QuestTaskComplete：QuestFile + Task（task uid）+ TaskComplete（布尔）。
            { "QuestTaskComplete": ["quests/example.qst", 305419896, true] },

            // type 2 HasExperience：Experience（u32），常配 cmp。
            { "HasExperience": [10000], "cmp": ">=" },

            // type 3 IsLevel：IsLevel（u32），常配 cmp。
            { "IsLevel": [10], "cmp": ">=" },

            // type 4 IsDifficulty：0 普通 / 1 精英 / 2 终极。
            { "IsDifficulty": [2], "cmp": "=" },

            // type 5 IsHardcore：布尔。
            { "IsHardcore": [false] },

            // type 6 HasFaction：FactionName（字符串）+ Value（u32），默认 bodyVersion=1。
            { "HasFaction": ["SURVIVORS", 5000], "cmp": ">=" },

            // type 7 HasToken：TokenName（字符串）+ HasToken（布尔）。
            { "HasToken": ["TOKEN_A", true] },

            // type 8 HasMoney：MoneyAmount（u32），常配 cmp。
            { "HasMoney": [1000], "cmp": ">=" },

            // type 9 HasItem：ItemRecord（.dbr）+ ItemCount（u32）+ CompleteOnly（布尔）；
            // 默认 bodyVersion=1，CompleteOnly 才会落盘。
            { "HasItem": ["records/items/gear/example.dbr", 1, false], "cmp": ">=" },

            // type 10 HasKilled：MonsterRecords（路径列表）+ KillCount（尾字 u32）。P 形态。
            { "HasKilled": { "MonsterRecords": ["records/monsters/example.dbr"], "KillCount": 1 }, "cmp": ">=" },

            // type 11 HasQuestObjective：Quest + Task（u32）+ Objective（u32）+ Satisfied（布尔）。
            {
              "HasQuestObjective": {
                "Quest": "quests/example.qst",
                "Task": 305419896,
                "Objective": 2271560481,
                "Satisfied": true
              }
            },

            // type 12 LuaScript（条件形态）：call + args + tail（Evaluate 尾部）。
            {
              "LuaScript": {
                "call": "gd.example.check()",
                "args": ["arg1"],
                "tail": { "t0": 0, "t1": 0, "t2": 0, "t3": 0, "text": "TRUE" }
              }
            },

            // type 13 KnowsPlayer：布尔。
            { "KnowsPlayer": [true] },

            // type 14 OnQuestTask：QuestFile + Task（u32）+ OnTask（布尔）。
            { "OnQuestTask": ["quests/example.qst", 305419896, true] },

            // type 15 UsedQuestItem：ItemRecord（.dbr）+ NumUsed（u32）。
            { "UsedQuestItem": ["records/items/quest/example.dbr", 1], "cmp": ">=" },

            // type 16 HasKilledProxy：ProxyRecords（路径列表）+ KillCount（尾字 u32）。P 形态。
            { "HasKilledProxy": { "ProxyRecords": ["records/proxies/example.dbr"], "KillCount": 1 }, "cmp": ">=" },

            // type 17 WaitForCompletion：无字段。
            { "WaitForCompletion": {} },

            // type 18 ServerHasToken：TokenName + HasToken（布尔）。
            { "ServerHasToken": ["TOKEN_B", true] },

            // type 19 QuestBlocked：QuestFile + 布尔（位置写法最直观）。
            { "QuestBlocked": ["quests/example.qst", false] },

            // type 20 AnyoneHasToken：TokenName + HasToken（布尔）。
            { "AnyoneHasToken": ["TOKEN_C", false] },

            // type 21 CheckRandomValue：Name（字符串）+ Value（u32），默认 bodyVersion=1。
            { "CheckRandomValue": ["roll", 50], "cmp": "<=" },

            // type 22 OwnsDLC：DLC_ID（u32）。
            { "OwnsDLC": [1], "cmp": "=" },

            // type 23 HasTribute：TributeAmount（u32）。
            { "HasTribute": [10], "cmp": ">=" },

            // type 24 EarnedDevotion：DevotionAmount（u32）。
            { "EarnedDevotion": [20], "cmp": ">=" },

            // type 25 HasMastery：MasteryName（u32 下标 0-29）+ HasMastery（布尔）。
            { "HasMastery": [0, true] },

            // type 26 IsChallenge：0 普通老兵 / 1 精英老兵 / 2 终极老兵。
            { "IsChallenge": [2], "cmp": ">=" },

            // type 27 HasBuff：BuffName（.dbr 路径）+ HasBuff（布尔）。
            { "HasBuff": ["records/buffs/example.dbr", true] },

            // type 28 HasKilledMonsterClass：MonsterClass1 + MonsterClass2 + KillCount（三个 u32）。
            // 前两值枚举：0 Common / 1 Champion / 2 Hero / 3 Boss / 4 Quest / 5 SuperBoss。
            { "HasKilledMonsterClass": [0, 5, 1], "cmp": ">=" },

            // type 29 HasKilledFaction：Faction1 + Faction2 + KillCount（三个 u32）。
            // 枚举：0 None / 1 Alone / 2 GenericMonster / 3 Player / 4 Survivors / 5 Aetherials /
            // 6 Cthonians / 7 Outlaws / 8 Beasts / 9 User0…（官方下拉可继续滚动）。
            { "HasKilledFaction": [4, 5, 100], "cmp": ">=" }
          ],

          "act": [
            // type 1 BeginQuestTask：QuestFile + Task（task uid）。
            { "BeginQuestTask": ["quests/example.qst", 305419896] },

            // type 2 CompleteQuest：QuestFile。
            { "CompleteQuest": ["quests/example.qst"] },

            // type 3 CompleteQuestTask：QuestFile + Task（task uid）。
            { "CompleteQuestTask": ["quests/example.qst", 305419896] },

            // type 4 GiveMoney：MoneyAmount（u32）。
            { "GiveMoney": [500] },

            // type 5 GiveFaction：FactionType（字符串）+ Amount（u32）。
            { "GiveFaction": ["SURVIVORS", 100] },

            // type 6 GiveItem：ItemRecord（.dbr）+ NumItems（u32）。
            { "GiveItem": ["records/items/gear/example.dbr", 1] },

            // type 7 GiveLevel：NumLevels（u32）。
            { "GiveLevel": [1] },

            // type 8 GiveExperience：Experience（u32）。
            { "GiveExperience": [1000] },

            // type 9 GiveToken：TokenName（字符串）。
            { "GiveToken": ["TOKEN_A"] },

            // type 10 RemoveToken：TokenName（字符串）。
            { "RemoveToken": ["TOKEN_A"] },

            // type 11 LuaScript（动作形态）：call + args；没有条件版的 tail。
            { "LuaScript": { "call": "gd.example.run()", "args": ["arg1"] } },

            // type 12 DebugPrint：Text（字符串）。
            { "DebugPrint": ["hello"] },

            // type 13 PlaySound：SoundRecord（.dbr 路径）。
            { "PlaySound": ["records/sounds/example.dbr"] },

            // type 14 PlayAnimation：AnimationType（u32 枚举）；语料中 9=Chat。
            { "PlayAnimation": [9] },

            // type 15 GiveSkillPoint：NumSkillpoints（u32）。
            { "GiveSkillPoint": [1] },

            // type 17 Notification：Tag（本地化标签字符串）。
            { "Notification": ["tagExample"] },

            // type 18 GiveAttribPoint：NumAttributePoints（u32）。
            { "GiveAttribPoint": [1] },

            // type 19 ScriptEvent：ScriptEvent（字符串，通常 EV_ 前缀）。
            { "ScriptEvent": ["EV_EXAMPLE"] },

            // type 20 GiveRandomItem：ItemRecord（.dbr）+ NumItems（u32）。
            { "GiveRandomItem": ["records/items/gear/example.dbr", 2] },

            // type 21 GenerateRandomValue：Name + Min（u32）+ Max（u32）。
            { "GenerateRandomValue": ["roll", 1, 100] },

            // type 22 CastSkill：SkillRecord（.dbr）。
            { "CastSkill": ["records/skills/example.dbr"] },

            // type 23 UnlockFaction：FactionType（字符串）。
            { "UnlockFaction": ["SURVIVORS"] },

            // type 24 SetFaction：FactionType（字符串）+ Value（u32）。
            { "SetFaction": ["SURVIVORS", 1000] },

            // type 25 GiveDevotion：NumDevotionPoints（u32）。
            { "GiveDevotion": [1] },

            // type 26 GiveTribute：TributeAmount（u32）。
            { "GiveTribute": [10] },

            // type 27 UnlockTutorial：TutorialPage（u32）。
            { "UnlockTutorial": [1] },

            // type 28 PlayVideo：Video path（路径字符串）+ AllowSkip（布尔）。
            { "PlayVideo": ["video/intro.ivf", false] }

            // type 0 / 16 不可用（工厂返回 null），不要写入。
          ]
        }
      ],

      "events": [
        {
          "unknown": 0,
          "logic": "AND",
          "cond": [],
          "act": [
            { "CompleteQuest": ["quests/example.qst"] },
            { "GiveExperience": [2500] },
            { "GiveMoney": [1000] }
          ]
        }
      ]
    }
  ]
}
